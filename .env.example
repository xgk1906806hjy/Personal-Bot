# Server
PORT=8787
HOST=0.0.0.0

# Messaging platforms (comma-separated). Ready: qq, feishu. Placeholder: wechat
MESSAGING_CHANNELS=qq

# Model plugin: gateway_api | codex_local | cursor_local
MODEL_CHANNEL=gateway_api

# Feishu (required when MESSAGING_CHANNELS includes feishu)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# QQ Open Platform bot (required when MESSAGING_CHANNELS includes qq)
QQ_APP_ID=
QQ_APP_SECRET=
QQ_API_BASE_URL=https://api.bot.qq.com
# websocket | webhook | both
QQ_TRANSPORT=websocket

# Local Codex CLI (when MODEL_CHANNEL=codex_local)
CODEX_WORKING_DIRECTORY=
# CODEX_BIN=codex

# Cursor SDK (MODEL_CHANNEL=cursor_local OR session /cursor mode with gateway_api)
# Requires Node >= 22.13 and: npm install --prefix scripts/cursor-agent
# /cursor enter mode; /cursor exit leave; normal messages then go to Cursor.
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# CURSOR_NODE_BIN=node
# CURSOR_AGENT_SCRIPT=scripts/cursor-agent/cursor-agent.mjs

# Gateway API (when MODEL_CHANNEL=gateway_api)
GATEWAY_API_BASE_URL=https://api.openai.com/v1
GATEWAY_API_KEY=
GATEWAY_API_MODEL=gpt-4o-mini
# GATEWAY_API_EXTRA_HEADER_NAME=
# GATEWAY_API_EXTRA_HEADER_VALUE=

# Session + personality
SESSION_TTL_HOURS=2
# Compress when message count exceeds this; keep last N raw messages + 1 summary
SESSION_COMPRESS_AFTER=30
SESSION_KEEP_RECENT=16
BOT_SYSTEM_PROMPT=You are my personal exclusive assistant. Be concise, practical, and clear. If you are unsure, say what is missing instead of guessing.

# Tools (gateway_api OpenAI-compatible function calling)
TOOLS_ENABLED=true
# Default start dir only; set_workdir may switch to any absolute path
TOOL_WORKSPACE=E:\cursor
TOOL_COMMAND_TIMEOUT_SEC=60
TOOL_MAX_ROUNDS=8
TOOL_MAX_OUTPUT_BYTES=100000
