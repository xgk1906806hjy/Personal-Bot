# Server
# WebSocket mode: any free port is fine. Webhook mode: QQ allows 80/443/8080/8443 only.
PORT=8787
HOST=0.0.0.0

# Messaging platforms (comma-separated). Ready: feishu, qq. Planned: wechat
MESSAGING_CHANNELS=qq

# Model plugin: codex_local | gateway_api
MODEL_CHANNEL=gateway_api

# Feishu / Lark (required when MESSAGING_CHANNELS includes feishu)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# QQ Open Platform bot (required when MESSAGING_CHANNELS includes qq)
# https://q.qq.com / https://bot.q.qq.com
QQ_APP_ID=
QQ_APP_SECRET=
QQ_API_BASE_URL=https://api.bot.qq.com
# websocket (recommended, no public domain) | webhook | both
QQ_TRANSPORT=websocket

# Local Codex plugin
CODEX_WORKING_DIRECTORY=
# CODEX_BIN=

# Gateway API (OpenAI-compatible chat completions)
GATEWAY_API_BASE_URL=https://api.openai.com/v1
GATEWAY_API_KEY=
GATEWAY_API_MODEL=gpt-4o-mini
# GATEWAY_API_EXTRA_HEADER_NAME=
# GATEWAY_API_EXTRA_HEADER_VALUE=

# Session + personality
SESSION_TTL_HOURS=2
BOT_SYSTEM_PROMPT=You are my personal exclusive assistant. Be concise, practical, and clear. If you are unsure, say what is missing instead of guessing.
